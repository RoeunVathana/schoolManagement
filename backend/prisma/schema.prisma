generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  TEACHER
  STUDENT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum CourseStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum CoursePaymentPlan {
  FULL
  MONTHLY
}

enum PostVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id                     String                @id @default(cuid())
  fullName               String
  email                  String                @unique
  firstName              String?
  lastName               String?
  firebaseUid            String?               @unique
  password               String
  phone                  String?
  profileImageUrl        String?
  role                   Role                  @default(STUDENT)
  status                 UserStatus            @default(ACTIVE)
  language               String                @default("en")
  canCreate              Boolean               @default(true)
  canEdit                Boolean               @default(true)
  canDelete              Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  profile                Profile?
  student                Student?
  teacher                Teacher?
  refreshTokens          RefreshToken[]
  notifications          Notification[]
  createdAnnouncements   Announcement[]        @relation("AnnouncementCreatedBy")
  registrationPayments   RegistrationPayment[]
  passwordResetOtps      PasswordResetOtp[]
  sentNotifications      Notification[]        @relation("NotificationSender")
  posts                  Post[]
  sentFriendRequests     FriendRequest[]       @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[]       @relation("FriendRequestReceiver")
  friendshipsA           Friendship[]          @relation("FriendshipUserA")
  friendshipsB           Friendship[]          @relation("FriendshipUserB")
  blocksGiven            UserBlock[]           @relation("UserBlocker")
  blocksReceived         UserBlock[]           @relation("UserBlocked")
  conversationsA         Conversation[]        @relation("ConversationUserA")
  conversationsB         Conversation[]        @relation("ConversationUserB")
  messagesSent           Message[]             @relation("MessageSender")

  @@map("users")
}

model Profile {
  id            String     @id @default(cuid())
  userId        String     @unique
  username      String     @unique
  email         String     @unique
  firstName     String?
  lastName      String?
  bio           String?    @db.Text
  avatar        String?
  coverImage    String?
  phone         String?
  location      String?
  website       String?
  school        String?
  course        String?
  yearLevel     String?
  company       String?
  role          Role       @default(STUDENT)
  accountStatus UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role, accountStatus])
  @@map("profiles")
}

model Post {
  id         String         @id @default(cuid())
  authorId   String
  content    String         @db.Text
  imageUrl   String?
  visibility PostVisibility @default(FRIENDS_ONLY)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
  @@index([visibility, createdAt])
  @@map("posts")
}

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  requestKey String?
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  sender     User                @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requestKey, status])
  @@index([senderId, status, createdAt])
  @@index([receiverId, status, createdAt])
  @@map("friend_requests")
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User     @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, createdAt])
  @@index([userBId, createdAt])
  @@map("friendships")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Conversation {
  id        String    @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userA     User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([userAId, userBId])
  @@index([userAId, updatedAt])
  @@index([userBId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model RegistrationPayment {
  id              String        @id @default(cuid())
  userId          String
  invoiceNumber   String        @unique
  publicToken     String        @unique
  qrString        String        @db.Text
  md5Hash         String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  expiresAt       DateTime
  paidAt          DateTime?
  transactionHash String?
  fromAccountId   String?
  toAccountId     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("registration_payments")
}

model Student {
  id             String              @id @default(cuid())
  userId         String              @unique
  studentCode    String              @unique
  gender         String?
  dateOfBirth    DateTime?
  address        String?
  guardianName   String?
  guardianPhone  String?
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  attendance     Attendance[]
  submissions    Submission[]
  examResults    ExamResult[]
  coursePayments CoursePayment[]
  certificates   CourseCertificate[]

  @@index([studentCode])
  @@map("students")
}

model Teacher {
  id                String              @id @default(cuid())
  userId            String              @unique
  teacherCode       String              @unique
  specialization    String?
  address           String?
  createdAt         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses           Course[]
  assignments       Assignment[]
  grades            Grade[]
  teacherAttendance TeacherAttendance[]

  @@index([teacherCode])
  @@map("teachers")
}

model Course {
  id                    String              @id @default(cuid())
  courseCode            String              @unique
  courseName            String
  description           String?
  teacherId             String
  startDate             DateTime
  endDate               DateTime
  status                CourseStatus        @default(ACTIVE)
  academicYearId        String?
  semesterId            String?
  imageUrl              String?
  price                 Decimal             @default(1.00) @db.Decimal(12, 2)
  currency              String              @default("USD")
  discountPercent       Float               @default(0)
  discountStart         DateTime?
  discountEnd           DateTime?
  monthlyPaymentEnabled Boolean             @default(false)
  monthlyPrice          Decimal?            @db.Decimal(12, 2)
  createdAt             DateTime            @default(now())
  teacher               Teacher             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  academicYear          AcademicYear?       @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  semester              Semester?           @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  enrollments           Enrollment[]
  schedules             ClassSchedule[]
  attendance            Attendance[]
  assignments           Assignment[]
  exams                 Exam[]
  announcements         Announcement[]
  coursePayments        CoursePayment[]
  materials             CourseMaterial[]
  certificates          CourseCertificate[]

  @@index([courseName])
  @@index([status])
  @@map("courses")
}

model Enrollment {
  id             String           @id @default(cuid())
  courseId       String
  studentId      String
  enrollmentDate DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}

model CoursePayment {
  id              String            @id @default(cuid())
  courseId        String
  studentId       String
  invoiceNumber   String            @unique
  publicToken     String            @unique
  qrString        String            @db.Text
  md5Hash         String            @unique
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("USD")
  paymentPlan     CoursePaymentPlan @default(FULL)
  billingPeriod   String?
  status          PaymentStatus     @default(PENDING)
  expiresAt       DateTime
  paidAt          DateTime?
  transactionHash String?
  fromAccountId   String?
  toAccountId     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, paymentPlan, billingPeriod])
  @@index([courseId, studentId, status])
  @@index([studentId, status])
  @@index([status, expiresAt])
  @@map("course_payments")
}

model CourseMaterial {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  description  String?
  fileUrl      String
  originalName String
  mimeType     String
  fileSize     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@map("course_materials")
}

model CourseCertificate {
  id           String   @id @default(cuid())
  courseId     String
  studentId    String
  title        String
  description  String?
  fileUrl      String
  originalName String
  mimeType     String
  fileSize     Int
  issuedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId, issuedAt])
  @@index([courseId, issuedAt])
  @@map("course_certificates")
}

model TelegramSetting {
  id        String   @id @default("telegram")
  botToken  String   @db.Text
  chatId    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("telegram_settings")
}

model ClassSchedule {
  id          String    @id @default(cuid())
  courseId    String
  dayOfWeek   DayOfWeek
  startTime   String
  endTime     String
  room        String?
  description String?
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("class_schedules")
}

model Attendance {
  id             String           @id @default(cuid())
  courseId       String
  studentId      String
  attendanceDate DateTime
  status         AttendanceStatus
  note           String?
  createdAt      DateTime         @default(now())
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, attendanceDate])
  @@index([studentId, attendanceDate])
  @@map("attendance")
}

model TeacherAttendance {
  id             String           @id @default(cuid())
  teacherId      String
  attendanceDate DateTime
  checkInAt      DateTime?
  checkOutAt     DateTime?
  status         AttendanceStatus @default(PRESENT)
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  teacher        Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, attendanceDate])
  @@index([attendanceDate])
  @@map("teacher_attendance")
}

model Assignment {
  id            String       @id @default(cuid())
  courseId      String
  teacherId     String
  title         String
  description   String?
  attachmentUrl String?
  maxScore      Float
  dueDate       DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher       Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  submissions   Submission[]

  @@index([courseId, dueDate])
  @@map("assignments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  answerText   String?
  fileUrl      String?
  submittedAt  DateTime         @default(now())
  status       SubmissionStatus
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade        Grade?

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("submissions")
}

model Grade {
  id           String     @id @default(cuid())
  submissionId String     @unique
  teacherId    String
  score        Float
  feedback     String?
  gradedAt     DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@map("grades")
}

model Exam {
  id                 String       @id @default(cuid())
  courseId           String
  title              String
  examDate           DateTime
  submissionDeadline DateTime?
  maxScore           Float
  description        String?
  imageUrl           String?
  course             Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  results            ExamResult[]

  @@index([courseId, examDate])
  @@map("exams")
}

model ExamResult {
  id          String    @id @default(cuid())
  examId      String
  studentId   String
  score       Float?
  feedback    String?
  answerText  String?
  fileUrl     String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@map("exam_results")
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String?
  createdBy String
  title     String
  content   String
  createdAt DateTime @default(now())
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author    User     @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([courseId, createdAt])
  @@map("announcements")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  senderId  String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender    User?    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([senderId])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetOtp {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@map("password_reset_otps")
}

model AcademicYear {
  id        String     @id @default(cuid())
  name      String     @unique
  startDate DateTime
  endDate   DateTime
  courses   Course[]
  semesters Semester[]

  @@map("academic_years")
}

model Semester {
  id             String       @id @default(cuid())
  name           String
  academicYearId String
  startDate      DateTime
  endDate        DateTime
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  courses        Course[]

  @@unique([academicYearId, name])
  @@map("semesters")
}
