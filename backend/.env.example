DATABASE_URL="postgresql://postgres:replace-with-local-password@localhost:5432/schoolManagement?schema=public"
# Keep this at or below the database plan's connection budget divided by the
# number of backend replicas. The hosted default is 10.
DATABASE_POOL_SIZE="5"
DATABASE_POOL_TIMEOUT="20"
NODE_ENV="development"
PORT=3000
JWT_ACCESS_SECRET="generate-a-random-secret-of-at-least-32-characters"
JWT_REFRESH_SECRET="generate-a-different-random-secret-of-at-least-32-characters"
JWT_ISSUER="campusflow-api"
JWT_AUDIENCE="campusflow-web"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS="12"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"
RATE_LIMIT_PER_MINUTE="240"
CODE_RUN_RATE_LIMIT="12"
# The default production runner is the HTTPS Judge0 CE sandbox. For a private
# deployment, set CODE_RUNNER_PROVIDER=judge0 and point CODE_RUNNER_URL at your
# Judge0 host, or set CODE_RUNNER_PROVIDER=piston for a Piston-compatible host.
CODE_RUNNER_PROVIDER="judge0"
CODE_RUNNER_URL="https://ce.judge0.com"
CODE_RUNNER_API_KEY=""
AUTH_RATE_LIMIT="30"
PAYMENT_RATE_LIMIT="30"
ENABLE_SWAGGER="true"
SEED_ADMIN_PASSWORD="set-a-strong-password-only-when-running-the-seed"
SEED_TEACHER_PASSWORD="set-a-strong-password-only-when-running-the-seed"
SEED_STUDENT_PASSWORD="set-a-strong-password-only-when-running-the-seed"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USER="your-email@gmail.com"
MAIL_PASSWORD="your-gmail-app-password"
MAIL_FROM="CampusFlow <your-email@gmail.com>"
# In production, a complete MAIL_* configuration takes priority over a saved
# admin record. Set this to "database" only when the admin settings page must
# be the active sender configuration.
MAIL_SETTINGS_SOURCE="environment"
# Optional HTTPS mail fallback for hosts that block outbound SMTP (for example Railway).
# Resend requires a verified sender domain and an API key.
MAIL_PROVIDER="auto"
RESEND_API_KEY=""
RESEND_API_URL="https://api.resend.com/emails"
PASSWORD_RESET_OTP_EXPIRES_MINUTES="10"
PASSWORD_RESET_OTP_SECRET="generate-a-different-random-secret-of-at-least-32-characters"
REDIS_URL="redis://:password@redis-host:6379"
FIREBASE_PROJECT_ID="shoolmanagement-65b53"
FIREBASE_API_KEY="your_firebase_web_api_key"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
MEDIA_STORAGE="local"
# On Railway attach a backend volume; its mount path is used automatically.
# Optional absolute override, which must point INSIDE the attached volume:
UPLOAD_DIR=""
FIREBASE_STORAGE_BUCKET="shoolmanagement-65b53.firebasestorage.app"
REGISTRATION_PAYMENT_REQUIRED="false"
REGISTRATION_FEE="1.00"
REGISTRATION_CURRENCY="USD"
PAYMENT_QR_EXPIRES_MINUTES="10"
BAKONG_API_URL="https://api-bakong.nbc.gov.kh"
BAKONG_API_ENABLED="false"
BAKONG_API_TOKEN=""
BAKONG_ACCOUNT_ID="your_bakong_account_id@bkrt"
MERCHANT_NAME="CampusFlow"
MERCHANT_CITY="Phnom Penh"
BAKONG_MERCHANT_CITY_KM="ភ្នំពេញ"
MERCHANT_PHONE="85512345678"
STORE_LABEL="CampusFlow"
# Never commit real Telegram credentials. Add these only in the deployment
# provider's secret variables or in an untracked local .env file.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ENABLED="true"
# Public HTTPS endpoint handled by the backend, for example:
# https://schoolmanagement-production-d78b.up.railway.app/telegram/webhook
TELEGRAM_WEBHOOK_URL=""
# Random value using only letters, numbers, underscores, and hyphens.
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_UPLOAD_TIMEOUT_MS="600000"
MEDIA_RETENTION_MONTHS="6"
# Back up media without deleting the originals or clearing their database URLs.
MEDIA_RETENTION_DELETE_AFTER_BACKUP="false"
MEDIA_RETENTION_CHECK_INTERVAL_HOURS="24"
MEDIA_RETENTION_START_DELAY_MS="60000"
MEDIA_EARLY_MIN_AGE_DAYS="30"
MEDIA_STORAGE_LIMIT_GB="0"
MEDIA_STORAGE_TARGET_RATIO="0.80"
MEDIA_ARCHIVE_CHUNK_MB="45"
MEDIA_ARCHIVE_DELAY_MS="1100"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
